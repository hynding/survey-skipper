{
  "name": "survey-skipper-react",
  "version": "0.2.0",
  "description": "React hooks for running survey-skipper surveys",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && printf '{\"type\":\"module\"}\\n' > dist/esm/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --import global-jsdom/register --test test/*.test.tsx",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hynding/survey-skipper.git",
    "directory": "packages/react"
  },
  "author": "Steve Hynding",
  "license": "MIT",
  "type": "commonjs",
  "peerDependencies": {
    "react": ">=18",
    "survey-skipper": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "global-jsdom": "^31.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "survey-skipper": "workspace:^"
  }
}
