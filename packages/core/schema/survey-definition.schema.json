{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hynding/survey-skipper/blob/master/packages/core/schema/survey-definition.schema.json",
  "title": "Survey Skipper definition",
  "description": "A survey definition as accepted by new SurveyDefinition(...) and produced by definition.toJSON(). Schema version 1.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "customKey": {
      "type": "string"
    },
    "keepAbandonedAnswers": {
      "type": "boolean"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "answerMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "variables": {
      "type": "object",
      "description": "Computed variables: name to JsonLogic expression.",
      "additionalProperties": {
        "$ref": "#/$defs/condition"
      }
    },
    "defaultLocale": {
      "type": "string"
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": [
        "string",
        "number"
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      ]
    },
    "condition": {
      "description": "A JsonLogic expression (https://jsonlogic.com).",
      "type": [
        "boolean",
        "object"
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "isCustom": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "if": {
          "$ref": "#/$defs/condition"
        },
        "goTo": {
          "$ref": "#/$defs/id"
        },
        "end": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "goTo"
          ],
          "not": {
            "required": [
              "end"
            ]
          }
        },
        {
          "required": [
            "end"
          ],
          "not": {
            "required": [
              "goTo"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "description": "A built-in type, or a name registered with registerQuestionType.",
          "anyOf": [
            {
              "enum": [
                "single",
                "multi",
                "text",
                "number",
                "rating",
                "date",
                "boolean"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "section": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "skipIf": {
          "$ref": "#/$defs/condition"
        },
        "validation": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "string"
              ]
            },
            "max": {
              "type": [
                "number",
                "string"
              ]
            },
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            },
            "minSelected": {
              "type": "integer",
              "minimum": 0
            },
            "maxSelected": {
              "type": "integer",
              "minimum": 0
            },
            "custom": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "args": {},
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "translations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "answers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
