{
  "name": "survey-skipper",
  "version": "3.9.0",
  "description": "A simple but smart survey system agnostic of service implementation details",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schema.json": "./schema/survey-definition.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && printf '{\"type\":\"module\"}\\n' > dist/esm/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cucumber-js",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hynding/survey-skipper.git",
    "directory": "packages/core"
  },
  "author": "Steve Hynding",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hynding/survey-skipper/issues"
  },
  "homepage": "https://github.com/hynding/survey-skipper#readme",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/json-logic-js": "^2.0.8",
    "ajv": "^8.20.0"
  },
  "dependencies": {
    "json-logic-js": "^2.0.5"
  },
  "module": "dist/esm/index.js"
}
